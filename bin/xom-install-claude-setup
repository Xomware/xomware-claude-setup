#!/usr/bin/env bash
# xom-install-claude-setup
#
# Skills, agents and hooks ship in the `xomware` plugin and are installed through
# the plugin marketplace, not copied. This script installs only the two things a
# plugin cannot carry:
#
#   ~/.claude/CLAUDE.md      global instructions
#   ~/.claude/settings.json  permissions.deny and model defaults
#     (plugin settings.json supports only `agent` and `subagentStatusLine`)
#
# It also clears out copies left by the pre-plugin installer, which would
# otherwise shadow the plugin's agents and duplicate its skills.
#
# Safe by default — never overwrites without --force, and backs up first.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SOURCE_DIR="$REPO_DIR/global"
CLAUDE_DIR="$HOME/.claude"
MARKETPLACE="Xomware/xomware-claude-setup"
FORCE=false
DRY_RUN=false
BACKUP_DIR="$CLAUDE_DIR/.backups/$(date +%Y%m%d-%H%M%S)"

usage() {
  cat <<'USAGE'
Usage: xom-install-claude-setup [--force] [--dry-run]

Installs the Xomware global CLAUDE.md and settings.json, and prints the
commands to register the plugin marketplace.

Options:
  --force    Overwrite existing files (backs them up first)
  --dry-run  Show what would happen without changing anything
  --help     Show this help
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

log() { echo "  $1"; }

backup_path() {
  local src="$1" rel="${1#$CLAUDE_DIR/}"
  local dst="$BACKUP_DIR/$rel"
  mkdir -p "$(dirname "$dst")"
  cp -R "$src" "$dst"
}

copy_file() {
  local src="$1" dst="$2"

  if [[ -f "$dst" && "$FORCE" == "false" ]]; then
    log "SKIP (exists): $dst"
    return
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    [[ -f "$dst" ]] && log "WOULD OVERWRITE: $dst" || log "WOULD CREATE: $dst"
    return
  fi

  if [[ -f "$dst" ]]; then
    backup_path "$dst"
    cp "$src" "$dst"
    log "UPDATED (backed up): $dst"
  else
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    log "CREATED: $dst"
  fi
}

# Remove a path the plugin now owns. Always backs up first — these are the only
# copies if the user edited them in place.
retire() {
  local path="$1" reason="$2"
  [[ -e "$path" ]] || return 0

  if [[ "$DRY_RUN" == "true" ]]; then
    log "WOULD RETIRE ($reason): $path"
    return
  fi

  backup_path "$path"
  rm -rf "$path"
  log "RETIRED ($reason, backed up): $path"
}

echo "xom-install-claude-setup"
echo "  Source: $SOURCE_DIR"
echo "  Target: $CLAUDE_DIR"
[[ "$FORCE" == "true" ]] && echo "  Mode: FORCE (backups to $BACKUP_DIR)"
[[ "$DRY_RUN" == "true" ]] && echo "  Mode: DRY RUN"
echo ""

if [[ -f "$SOURCE_DIR/hooks/check-runtime.sh" && "$DRY_RUN" == "false" ]]; then
  bash "$SOURCE_DIR/hooks/check-runtime.sh" 2>/dev/null || true
fi

[[ "$DRY_RUN" == "false" ]] && mkdir -p "$CLAUDE_DIR"

copy_file "$SOURCE_DIR/CLAUDE.md" "$CLAUDE_DIR/CLAUDE.md"

if [[ -f "$CLAUDE_DIR/settings.json" && "$FORCE" == "false" ]]; then
  log "SKIP (exists): $CLAUDE_DIR/settings.json"
  log "  Merge manually, or re-run with --force to replace it."
  log "  It must contain: \"enabledPlugins\": { \"xomware@xomware\": true }"
else
  copy_file "$SOURCE_DIR/settings.json" "$CLAUDE_DIR/settings.json"
fi

echo ""
echo "Retiring pre-plugin copies:"

# Agents: a user-level agent overrides a same-named plugin agent, so leftovers
# silently win over the plugin and never update.
for f in "$CLAUDE_DIR"/agents/*.md; do
  [[ -f "$f" ]] || continue
  name="$(basename "$f" .md)"
  [[ -f "$REPO_DIR/plugins/xomware/agents/$name.md" ]] || continue
  retire "$f" "now provided by the xomware plugin"
done

# Skills: plugin skills are namespaced, so a leftover copy doesn't conflict — it
# just shows up a second time and drifts.
for d in "$CLAUDE_DIR"/skills/*/; do
  [[ -d "$d" ]] || continue
  name="$(basename "$d")"
  [[ -f "$REPO_DIR/plugins/xomware/skills/$name/SKILL.md" ]] || continue
  retire "${d%/}" "now provided by the xomware plugin"
done

# Flat skills/<name>.md were never loaded by Claude Code at all.
for f in "$CLAUDE_DIR"/skills/*.md; do
  [[ -f "$f" ]] || continue
  retire "$f" "flat skill file, never loaded"
done

# Commands superseded by a plugin skill of the same name.
for f in "$CLAUDE_DIR"/commands/*.md; do
  [[ -f "$f" ]] || continue
  name="$(basename "$f" .md)"
  [[ -f "$REPO_DIR/plugins/xomware/skills/$name/SKILL.md" ]] || continue
  retire "$f" "superseded by the xomware plugin skill"
done

# Hook scripts now invoked from the plugin via ${CLAUDE_PLUGIN_ROOT}.
for f in guard-bash.js session-end.js track-changes.js; do
  retire "$CLAUDE_DIR/hooks/$f" "now provided by the xomware plugin"
done

echo ""
if [[ "$DRY_RUN" == "true" ]]; then
  echo "Dry run complete. Nothing was changed."
  exit 0
fi

echo "Global config installed."
echo ""
echo "Now install the plugin (one time):"
echo ""
echo "  claude plugin marketplace add $MARKETPLACE"
echo "  claude plugin install xomware@xomware"
echo ""
echo "Already installed? Pull the latest instead:"
echo ""
echo "  claude plugin marketplace update xomware"
echo "  claude plugin update xomware@xomware"
echo ""
[[ -d "$BACKUP_DIR" ]] && echo "Backups: $BACKUP_DIR"
exit 0
